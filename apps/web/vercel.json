{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"rewrites": [
		{ "source": "/sitemap.xml", "destination": "https://vapeshop-backend.onrender.com/sitemap.xml" },
		{ "source": "/robots.txt", "destination": "https://vapeshop-backend.onrender.com/robots.txt" },
		{ "source": "/(.*)", "destination": "/index.html" }
	]
}
